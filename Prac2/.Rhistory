"\\hline\n"
)
print(
xt,
include.rownames = FALSE,
include.colnames = FALSE,
caption.placement = "top",
table.placement = "H",
add.to.row = list(
pos = list(-1),
command = header
),
hline.after = nrow(tabla1),
comment = FALSE
)
