timevar = "smoker",
direction = "wide"
)
tabla1 <- tabla1[, c(
"age",
"personYears.no",
"personYears.yes",
"deaths.no",
"deaths.yes"
)]
rownames(tabla1) <- NULL
xt <- xtable(
tabla1,
caption = "Data on coronary death rates.",
