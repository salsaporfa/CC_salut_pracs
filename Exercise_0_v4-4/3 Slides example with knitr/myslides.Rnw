%%% BEGIN caja de texto personalizada
%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Definicion del entorno personalizado:
% \begin{mybeamerbox}[ancho]{título} ... \end{mybeamerbox}
\newenvironment{mybeamerbox}[2][0.85]{%
  \begin{center}%
  \begin{minipage}{#1\paperwidth}%
  \begin{beamerboxesrounded}[upper=upperboxcolor,lower=lowerboxcolor,shadow=true,width=\textwidth]{#2}%
}{%
  \end{beamerboxesrounded}%
  \end{minipage}%
  \end{center}%
}

