% you can put R chunks outside slides and show results later inside a slide:

<<countsexampledata, echo = FALSE, purl=FALSE>>=
E0D0 <- 192
E0D1 <- 48
E1D0 <- 84
E1D1 <- 36

E0 <- E0D0 + E0D1
E1 <- E1D0 + E1D1
D0 <- E0D0 + E1D0
D1 <- E0D1 + E1D1
n <- E0 + E1
rr <- (E1D1 / E1) / (E0D1 / E0)
or <- (E0D0 * E1D1) / (E0D1 * E1D0)
@



