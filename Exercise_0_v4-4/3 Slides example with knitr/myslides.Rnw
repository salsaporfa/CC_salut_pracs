\begin{frame}
\frametitle{A table}

\begin{mybeamerbox}[0.9]{Box title here}

\begin{itemize}
\justifying
\item A \(2 \times 2\) contingency table:

\begin{table}[h]
\begin{center}
\begin{tabular}{ld{3.0}d{3.0}cd{3.0}}
\toprule
& \multicolumn{2}{c}{\textbf{Disease}}
& \multicolumn{2}{c}{}\\
\cmidrule(rl){2-3}
\textbf{Exposed}
& \multicolumn{1}{c}{No} 
& \multicolumn{1}{c}{Yes} 
&
& 
\multicolumn{1}{c}{\bf Total} \\
\midrule
No                & \Sexpr{E0D0} &  \Sexpr{E0D1} & & \Sexpr{E0}\\
Yes               & \Sexpr{E1D0} &  \Sexpr{E1D1} & & \Sexpr{E1}\\
\midrule
\textbf{Total} & \Sexpr{D0}      &     \Sexpr{D1} &  &  \Sexpr{n}\\
\bottomrule
\end{tabular}
\end{center}
\end{table}

\item Bye.

\end{itemize}

\end{mybeamerbox}


\end{frame}


%--------------------------------------
%--------------------------------------
%-- Another table (with \Robject{xtable})
%--------------------------------------
%--------------------------------------
\begin{frame}
\frametitle{Another table (with \Robject{xtable})}


\begin{mybeamerbox}[0.7]{Linear regression}

Table \ref{tab:coeftable} shows my results.

<<mytable, echo=FALSE, results = 'asis'>>=
### linear regression model fitting:
mod <- lm(Ozone ~ Wind, data = airquality)
### get coefficients table:
coefs <- summary(mod)$coefficients
# exporting coefficients table to LaTeX format:
modtable <- xtable(coefs,
                   digits = c(0, 2, 2, 2, 4),
                   caption = "Linear regression model coefficients for wind and ozone association.",
                   label = "tab:coeftable")
# cosmetics for table head (LaTeX slash (\) must be doubled inside a R chunk):
colnames(modtable) <- c("\\multicolumn{1}{c}{\\bf{\\color{blue}Estimate}}",
                        "\\multicolumn{1}{c}{\\bf Std.~Error}",
                        "\\multicolumn{1}{c}{\\(\\boldsymbol{t}\\)\\bf{-value}}",
                        "\\multicolumn{1}{c}{\\(\\boldsymbol{p}\\)\\bf{-value}}")

# format and print the table:
print(modtable,
      size = "footnotesize",
      include.rownames = TRUE,
      include.colnames = TRUE,
      floating = TRUE,                 # whether \begin{table} should be created (TRUE) or not (FALSE)
      sanitize.text.function = force,  # important to treat content of columns as latex function
      booktabs = TRUE)                 # requires \usepackage{booktabs} in the preamble of the document
@



\end{mybeamerbox}


\end{frame}


%--------------------------------------
%--------------------------------------
%-- A plot in a box
