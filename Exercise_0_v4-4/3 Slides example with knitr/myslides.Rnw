%\setbeamercolor*{structure}{bg=PineGreen!20,fg=PineGreen}
\setbeamercolor*{structure}{bg=PineGreen!20,fg=PineGreen}
\setbeamercolor*{palette primary}{use=structure,fg=white,bg=structure.fg!70}
\setbeamercolor*{palette secondary}{use=structure,bg=structure.fg!20}
\setbeamercolor*{palette tertiary}{use=structure,fg=white,bg=structure.fg}
\setbeamercolor*{palette quaternary}{fg=white,bg=black}
\setbeamerfont{section in toc}{size=\small}
\setbeamercolor{section in toc}{fg=bg=structure.fg,bg=white}
\setbeamerfont{subsection in toc}{size=\footnotesize}
\setbeamercolor{subsection in toc}{fg=bg=structure.fg,bg=white}
\useinnertheme{circles}
\beamertemplatenavigationsymbolsempty
%\setbeamertemplate{footline}[frame number]
\setbeamertemplate{caption}[numbered]
%\setbeamercolor{upperboxcolor}{fg=white,bg=blue!50!black}
\setbeamercolor{upperboxcolor}{fg=white,bg=structure.fg}
%\setbeamercolor{lowerboxcolor}{fg=black,bg=blue!10!white}
\setbeamercolor{lowerboxcolor}{fg=black,bg=structure.fg!8!white}
%\setbeamercolor{title}{fg=blue!30!black, bg=blue!20!white}
\setbeamercolor{title}{fg=structure.fg!5!white, bg=structure.fg}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}


\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=structure.fg, % Enlaces internos (secciones, figuras, tablas) en verde
    urlcolor=structure.fg,  % Direcciones web en verde
    citecolor=blue          % Citas bibliográficas [1] en azul
}
