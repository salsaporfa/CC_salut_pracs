\begin{frame}[fragile]
\frametitle{A plot in a box}

\begin{mybeamerbox}[0.6]{A plot}

I like Figure \ref{fig:dataplot}.


<<dataplot, echo=FALSE, fig.pos='ht', fig.align='center', fig.width=8, fig.height=6, out.width='0.7\\textwidth', fig.cap='\\label{fig:dataplot}Scatter plot of ozone levels vs. wind speed.'>>=

### scatter plot ozone vs. wind:
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
     airquality$Ozone,
     xlab = "Wind speed (mph)",
     ylab = "Ozone levels (ppb)",
     pch = 19,
     col = "red")
@

\end{mybeamerbox}


\end{frame}


