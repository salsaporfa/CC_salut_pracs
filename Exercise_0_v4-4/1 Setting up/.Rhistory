}
#### Example:
# simulate toy temperatures for a given city:
set.seed(666)
n <- 150
tempCity <- round(rnorm(n, mean = 17, sd = 5), 1)
# include some NA:
tempCity[1:3] <- NA
tempCity
temp <- tempCity
perc = 0:100
pct <- quantile(temp, probs = perc / 100, na.rm = TRUE)
# compute the percentiles associated to each temperature value:
reschar <- unlist(sapply(temp, FUN = function(t) getpctchar(x = t, percentiles = pct)))
resnum <- as.numeric(strsplit(reschar, "%"))
reschar
class(reschar)
factor(reschar, levels = paste0(perc, "%"))
res <- data.frame(pctchar = reschar, pctnum = resnum)
res
summary(res)
res <- data.frame(pctchar = factor(reschar, levels = paste0(perc, "%")), pctnum = resnum)
res
summary(res)
class(res$pctchar)
rm(list = ls())
# auxiliar function, called by "getpctcity", to get the percentile for a given temperature value
getpctchar <- function(x, percentiles) {
res <- NA
if (!is.na(x)) {
aux <- percentiles[x >= percentiles]
res <- names(aux[length(aux)])
}
res
}
# function to get the percentile for all temperature values in a given city:
getpctcity <- function(temp, perc = 0:100) {
# compute the percentiles 1 to 100:
pct <- quantile(temp, probs = perc / 100, na.rm = TRUE)
# compute the percentiles associated to each temperature value:
reschar <- unlist(sapply(temp, FUN = function(t) getpctchar(x = t, percentiles = pct)))
resnum <- as.numeric(strsplit(reschar, "%"))
res <- data.frame(pctchar = factor(reschar, levels = paste0(perc, "%")), pctnum = resnum)
res
}
