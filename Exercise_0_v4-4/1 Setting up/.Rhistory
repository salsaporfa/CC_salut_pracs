# Agresti 2nd Edition. Exercise 4.11
rm(list = ls())
age <- as.factor(1:5)
age1 <- seq(35, 75, by = 10)
age2 <- age1 + 9
levels(age) <- paste0("[", age1, "-", age2, "]")
dd <- data.frame(rep(age, 2))
dd$smoker <- as.factor(rep(0:1, each = length(age1)))
levels(dd$smoker) <- c("no", "yes")
dd$personYears <- c(18793, 10673, 5710, 2585, 1462,
52407, 43248, 28612, 12663, 5317)
