p0 <- c(1 / 1000, 1 / 100, 1 / 50, 1/20, 1 / 10, 1 / 4)
RRrange <- c(0.5, 2)
l <- length(p0)
RRmin <- RRrange[1]
RRmax <- RRrange[2]
RR <- seq(RRmin, RRmax, by = 0.01)
par(las = 1, cex.main = 1, cex.axis = 1, cex.lab = 1, oma = c(0, 0, 0, 0))
cols <- l:1
plot(RRrange, RRrange, type = "n", main = "", xlab = "RR", ylab = "OR", xaxt = "n", yaxt = "n")
axis(1, at = c(RRmin, 1, RRmax))
axis(2, at = c(RRmin, 1, RRmax))
for (i in 1:l)
{
OR <- RR * (1 -p0[i]) / (1 - p0[i] * RR)
lines(RR, OR, type = "l", col = cols[i], lwd = 3)
}
