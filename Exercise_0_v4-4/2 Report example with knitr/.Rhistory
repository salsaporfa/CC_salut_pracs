## ----libraries, include=FALSE-------------------------------------------------------------------
### libraries related to knit:
library(knitr)
library(highlight)  # to highlight R output
library(xtable)     # to export R output tables to LaTeX
## ----dataplot, fig.width = 8, fig.height = 8, out.width = '0.5\\textwidth'----------------------
# scatter plot ozone vs. wind:
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
airquality$Ozone,
xlab = "Wind speed (mph)",
ylab = "Ozone levels (ppb)",
pch = 19,
col = "gray")
## ----modeling-----------------------------------------------------------------------------------
# linear regression model fitting:
mod <- lm(Ozone ~ Wind, data = airquality)
# get coefficients table:
coefs <- summary(mod)$coefficients
# get beta of interest:
beta <- coefs["Wind", "Estimate"]
## ----betaformat---------------------------------------------------------------------------------
### store some things realted to the beta of interest, to be used with \Sexpr{}
### in the report:
# first, we store the absolute value of beta:
betaabs <- abs(beta)
# now, we format it to be printed with 2 decimal places using sprintf:
betafancy <- sprintf("%.2f", betaabs)
# now we want to use "increase" or "decrease" in the report depending on if
# beta is positive or negative, respectively. We store it in the object "eff"
# (for "effect"):
eff <- ifelse(beta > 0, "increase", "decrease")
## ----mytable, results = 'asis'------------------------------------------------------------------
# exporting coefficients table to LaTeX format:
modtable <- xtable(coefs,
digits = c(0, 2, 2, 2, 4),
caption = "Linear regression model coefficients for wind and ozone association.",
label = "tab:coeftable")
# cosmetics for table head (LaTeX slash (\) must be doubled inside a R chunk):
colnames(modtable) <- c("\\multicolumn{1}{c}{\\bf Estimate}",
"\\multicolumn{1}{c}{\\bf Std.~Error}",
"\\multicolumn{1}{c}{$\\boldsymbol{t}$\\bf{-value}}",
"\\multicolumn{1}{c}{$\\boldsymbol{p}$\\bf{-value}}")
# format and print the table:
print(modtable,
size = "footnotesize",
include.rownames = TRUE,
include.colnames = TRUE,
floating = TRUE,                 # whether \begin{table} should be created (TRUE) or not (FALSE)
sanitize.text.function = force,  # important to treat content of columns as latex function
booktabs = TRUE)                 # requires \usepackage{booktabs} in the preamble of the document
## ----modelplot, fig.width = 8, fig.height = 8, out.width = '0.5\\textwidth'---------------------
<<dataplot>>  # chunk recycling
<<modeling>>  # chunk recycling
abline(mod, col = "blue", lwd = 2)
## ----modelplot, fig.width = 8, fig.height = 8, out.width = '0.5\\textwidth'---------------------
<<dataplot>>  # chunk recycling
<<modeling>>  # chunk recycling
abline(mod, col = "blue", lwd = 2)
library(knitr)
library(highlight)  # to highlight R output
library(xtable)
options(
width = 70, # max. width, in characters, of the R output. Default is 80.
scipen = 4  # to avoid printing inline R output numbers in scientific
# notation if they are lower than 10^4
)
opts_chunk$set(
echo = FALSE,         # don't show R input code
message = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
warning = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
size = "footnotesize", # set the R output and output font size
cache = TRUE,         # useful for computationally costly chunks (be careful!)
prompt = TRUE         # set the prompt presence/symbol
)
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
airquality$Ozone,
xlab = "Wind speed (mph)",
ylab = "Ozone levels (ppb)",
pch = 19,
col = "gray")
# linear regression model fitting:
mod <- lm(Ozone ~ Wind, data = airquality)
# get coefficients table:
coefs <- summary(mod)$coefficients
# get beta of interest:
beta <- coefs["Wind", "Estimate"]
### store some things realted to the beta of interest, to be used with \Sexpr{}
### in the report:
# first, we store the absolute value of beta:
betaabs <- abs(beta)
# now, we format it to be printed with 2 decimal places using sprintf:
betafancy <- sprintf("%.2f", betaabs)
# now we want to use "increase" or "decrease" in the report depending on if
# beta is positive or negative, respectively. We store it in the object "eff"
# (for "effect"):
eff <- ifelse(beta > 0, "increase", "decrease")
# exporting coefficients table to LaTeX format:
modtable <- xtable(coefs,
digits = c(0, 2, 2, 2, 4),
caption = "Linear regression model coefficients for wind and ozone association.",
label = "tab:coeftable")
# cosmetics for table head (LaTeX slash (\) must be doubled inside a R chunk):
colnames(modtable) <- c("\\multicolumn{1}{c}{\\bf Estimate}",
"\\multicolumn{1}{c}{\\bf Std.~Error}",
"\\multicolumn{1}{c}{$\\boldsymbol{t}$\\bf{-value}}",
"\\multicolumn{1}{c}{$\\boldsymbol{p}$\\bf{-value}}")
# format and print the table:
print(modtable,
size = "footnotesize",
include.rownames = TRUE,
include.colnames = TRUE,
floating = TRUE,                 # whether \begin{table} should be created (TRUE) or not (FALSE)
sanitize.text.function = force,  # important to treat content of columns as latex function
booktabs = TRUE)                 # requires \usepackage{booktabs} in the preamble of the document
