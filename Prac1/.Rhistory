box_muller <- function() {
U1 <- runif(1)
U2 <- runif(1)
X <- sqrt(-2 * log(U1)) * cos(2 * pi * U2)
Y <- sqrt(-2 * log(U1)) * sin(2 * pi * U2)
R2 <- X^2+Y^2; r <- sqrt(R2)
theta <- atan(Y(X))
resultat <- (4*pi)^-1*exp(-(2/2))*r*theta
return(resultat)
}
c(1,2,3)/c(1,2,3)
marsaglia_bray <- function(n){
U1 <- runif(n)
bar_U1 <- runif(n)
bar_U2 <- runif(n)
V1 <- 2*bar_U1-1
V2 <- 2*bar_U2-1
coseno <- V1/(sqrt(V1^2,V2^2))
seno <- V2/(sqrt(V1^2,V2^2))
X <- sqrt(-2 * log(U1)) * coseno
Y <- sqrt(-2 * log(U1)) * seno
R2 <- X^2+Y^2
r <- sqrt(R2)
theta <- atan(Y/X)
resultat <- (4*pi)^-1*exp(-(r/2))*r*theta
return(resultat)
}
