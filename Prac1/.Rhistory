marsaglia_bray <- function(n) {
X <- numeric(n)
Y <- numeric(n)
i <- 1
while (i <= n) {
U1 <- runif(1, -1, 1)
U2 <- runif(1, -1, 1)
S <- U1^2 + U2^2
if (S > 0 && S < 1) {
factor <- sqrt(-2 * log(S) / S)
X[i] <- U1 * factor
Y[i] <- U2 * factor
i <- i + 1
}
}
cbind(X, Y)
}
set.seed(20260518)
library(microbenchmark)
bench <- microbenchmark(
Box_Muller = box_muller(10000),
Marsaglia_Bray = marsaglia_bray(10000),
Built_in = cbind(rnorm(10000),rnorm(10000)),
times = 100
)
boxplot(bench,
main = "Comparació dels temps dels tres mètodes",
ylab = "Temps",
xlab = "Mètode")
