install.packages("microbenchmark")
marsaglia_bray <- function(n){
U1 <- runif(n)
bar_U1 <- runif(n)
bar_U2 <- runif(n)
V1 <- 2*bar_U1-1
V2 <- 2*bar_U2-1
coseno <- V1/(sqrt(V1^2+V2^2))
seno <- V2/(sqrt(V1^2+V2^2))
X <- sqrt(-2 * log(U1)) * coseno
Y <- sqrt(-2 * log(U1)) * seno
return(cbind(X,Y))
}
set.seed(20260518)
library(microbenchmark)
bench <- microbenchmark(
Box_Muller = box_muller(10000),
Marsaglia_Bray = marsaglia_bray(10000),
Built_in = cbind(rnorm(10000),rnorm(10000)),
times = 100
)
