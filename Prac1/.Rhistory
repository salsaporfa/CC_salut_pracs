box_muller <- function(n) {
m <- ceiling(n / 2)
U1 <- runif(m)
U2 <- runif(m)
X <- sqrt(-2 * log(U1)) * cos(2 * pi * U2)
Y <- sqrt(-2 * log(U1)) * sin(2 * pi * U2)
XY <- c(X, Y)
return(XY[1:n])
}
