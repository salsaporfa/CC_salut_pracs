box_muller <- function(n) {
U1 <- runif(n)
U2 <- runif(n)
X <- sqrt(-2 * log(U1)) * cos(2 * pi * U2)
Y <- sqrt(-2 * log(U1)) * sin(2 * pi * U2)
R2 <- X^2+Y^2
r <- sqrt(R2)
theta <- atan(Y/X)
resultat <- (4*pi)^-1*exp(-(r/2))*r*theta
return(resultat)
}
box_muller(n=12)
hist(box_muller(12))
hist(box_muller(200))
hist(box_muller(1000))
hist(box_muller(10000))
