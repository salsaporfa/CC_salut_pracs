# ex1_a
inferior <- dades$Inferior
cat("La mitjana mostral = ", mean(inferior),"\n")
cat("La mitjana mostral = ", median(inferior))
# ex1_b1
n <- length(inferior)
B <- 2000
m_boot <- numeric(B)
set.seed(20260508)
for(i in 1:B) {
mostra_b <- sample(inferior, size = n, replace = TRUE)
m_boot[i] <- mean(mostra_b)
}
se_m <- sd(m_boot)
cat("L'error estàndard de les mitjanes estimats per Bootstrap és:", se_m, "\n")
# ex1_b2
set.seed(20260508)
M_boot <- numeric(B)
for(i in 1:B) {
mostra_b <- sample(inferior, size = n, replace = TRUE)
M_boot[i] <- median(mostra_b)
}
se_M <- sd(M_boot)
cat("L'error estàndard de les medianes estimats per Bootstrap és:", se_M, "\n")
# ex1_c
bias_m <- mean(m_boot)-mean(inferior)
bias_M <- mean(M_boot)-median(inferior)
cat("El biaix per a la mitjana = ", bias_m, "\n")
cat("El biaix per a la mediana = ", bias_M, "\n")
